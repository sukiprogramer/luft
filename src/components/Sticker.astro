---
// 14-point starburst sticker with a one- or two-word label.
interface Props { lines?: string[]; size?: number; class?: string; label?: string; fill?: 'yellow' | 'paper' }
const { lines = [], size = 128, class: className, label, fill = 'yellow' } = Astro.props;
const points = '124.0,64.0 108.8,74.2 118.1,90.0 100.0,92.7 101.4,110.9 84.0,105.4 77.4,122.5 64.0,110.0 50.6,122.5 44.0,105.4 26.6,110.9 28.0,92.7 9.9,90.0 19.2,74.2 4.0,64.0 19.2,53.8 9.9,38.0 28.0,35.3 26.6,17.1 44.0,22.6 50.6,5.5 64.0,18.0 77.4,5.5 84.0,22.6 101.4,17.1 100.0,35.3 118.1,38.0 108.8,53.8';
const name = label ?? lines.join(' ');
const startY = lines.length > 1 ? 60 : 68;
---
<svg class:list={['sticker', `sticker-${fill}`, className]} width={size} height={size} viewBox="0 0 128 128"
  {...(name ? { role: 'img', 'aria-label': name } : { 'aria-hidden': 'true' })}>
  <polygon points={points} />
  {lines.map((l, i) => <text x="64" y={startY + i * 16} text-anchor="middle">{l.toUpperCase()}</text>)}
</svg>

<style>
  .sticker { overflow: visible; }
  polygon { fill: var(--yellow); stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; }
  /* On a yellow poster the sticker is paper with an on-yellow stroke. */
  .sticker-paper polygon { fill: var(--paper); stroke: var(--on-yellow); stroke-width: 3; }
  text { font: 600 13px var(--font-sans); fill: var(--on-yellow); }
</style>
