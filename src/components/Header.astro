---
// Site header: wordmark, page links and Say hi. On phones the links move into a full-screen yellow menu.
import Button from './Button.astro';
import { pages } from '../data/site';
import { link } from '../data/link';

interface Props { current: string }
const { current } = Astro.props;
const links = pages.filter((p) => p.href !== '/');
const isCurrent = (href: string) => (href === current ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap header-row">
    <a href={link('/')} class="wordmark" aria-current={isCurrent('/')}>LUFT</a>
    <nav aria-label="Main" class="header-nav">
      {links.map((p) => <a href={link(p.href)} class="nav-link" aria-current={isCurrent(p.href)}>{p.label}</a>)}
    </nav>
    <div class="header-actions">
      <Button variant="accent" data-say-hi>Say hi</Button>
      <button type="button" class="menu-btn" aria-label="Open menu" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><path d="M3 6 H19 M3 11 H19 M3 16 H19" /></svg>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="site-menu" aria-label="Menu">
  <div class="menu-top">
    <a href={link('/')} class="wordmark">LUFT</a>
    <button type="button" class="menu-btn is-visible" aria-label="Close menu" data-menu-close autofocus>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 16 16"><path d="M3 3 L13 13 M13 3 L3 13" /></svg>
    </button>
  </div>
  <nav aria-label="Main (mobile)" class="menu-nav">
    {pages.map((p) => <a href={link(p.href)} class="menu-link disp" aria-current={isCurrent(p.href)}>{p.label}</a>)}
  </nav>
  <Button variant="primary" class="menu-hi" data-say-hi data-menu-close>Say hi</Button>
</dialog>

<style>
  .site-header { background: var(--paper); }
  .header-row {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-5);
  }
  .wordmark {
    font-family: var(--font-hand); font-size: 44px; line-height: 1; letter-spacing: 2px;
    text-transform: uppercase; color: var(--ink); text-decoration: none;
    min-height: var(--touch-min); display: inline-flex; align-items: center;
  }
  .wordmark:hover { color: var(--ink); }
  .header-nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) 28px; margin-left: auto; }
  .nav-link {
    font: 500 15px/1.2 var(--font-sans); color: var(--ink); text-decoration: none;
    padding: var(--space-3) 0; min-height: var(--touch-min); display: inline-flex; align-items: center;
  }
  .nav-link:hover, .nav-link[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline; text-decoration-color: var(--yellow);
    text-decoration-thickness: 4px; text-underline-offset: 6px;
  }
  .header-actions { display: flex; align-items: center; gap: var(--space-3); }
  .menu-btn {
    display: none; width: var(--touch-min); height: var(--touch-min);
    align-items: center; justify-content: center;
    border: var(--border-bold) solid var(--line); border-radius: var(--radius-pill);
    background: transparent; color: var(--ink); cursor: pointer;
  }
  .menu-btn svg path { stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; fill: none; }
  .menu-btn.is-visible { display: inline-flex; }

  @media (max-width: 599px) {
    .site-header { position: sticky; top: 0; z-index: 20; border-bottom: var(--border-hairline) solid var(--rule-soft); }
    .header-row { flex-wrap: nowrap; padding-block: var(--space-3); }
    .wordmark { font-size: 34px; }
    .header-nav { display: none; }
    .menu-btn { display: inline-flex; }
  }

  /* Full-screen yellow menu */
  .site-menu {
    width: 100%; height: 100%; max-width: none; max-height: none; margin: 0;
    border: 0; padding: var(--space-3) var(--gutter-mobile) var(--space-7);
    background: var(--yellow); color: var(--on-yellow);
    flex-direction: column; gap: var(--space-6);
  }
  .site-menu[open] { display: flex; animation: menu-in 160ms ease-out; }
  .site-menu .wordmark { font-size: 34px; color: var(--on-yellow); }
  .site-menu .menu-btn { border-color: var(--on-yellow); color: var(--on-yellow); }
  .menu-top { display: flex; justify-content: space-between; align-items: center; }
  .menu-nav { display: flex; flex-direction: column; }
  .menu-link {
    font-size: 46px; line-height: 1.1; color: var(--on-yellow); text-decoration: none;
    padding-block: var(--space-4); border-bottom: var(--border-bold) solid var(--on-yellow);
  }
  .menu-link:first-child { border-top: var(--border-bold) solid var(--on-yellow); }
  .menu-link:hover { color: var(--on-yellow); }
  .menu-link[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 8px; }
  .site-menu :global(.menu-hi) { margin-top: auto; width: 100%; background: var(--on-yellow); color: var(--yellow); border-color: var(--on-yellow); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
</style>
