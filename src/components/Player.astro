---
// Radio Luft playlist: a now-playing bar, then the tracks as buttons.
// There is no audio yet; give tracks a `url` in src/data/eos.ts to make them link out.
import type { Track } from '../data/eos';

interface Props { title: string; curator: string; tracks: Track[]; id?: string }
const { title, curator, tracks, id = 'player' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(tracks.length);
---
<div class="player" id={id} data-player data-total={total}>
  <div class="player-head">
    <h2 class="disp player-title">{title}</h2>
    <svg aria-hidden="true" width="64" height="64" viewBox="0 0 64 64" class="note"><path d="M22 46 V12 L54 6 V40" /><circle cx="16" cy="46" r="7" /><circle cx="48" cy="40" r="7" /></svg>
  </div>

  <div class="now">
    <button type="button" class="ctl" aria-label="Previous track" data-prev>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M12 3 L5 8 L12 13 Z M4 3 V13" /></svg>
    </button>
    <button type="button" class="play" aria-label="Play" data-toggle>
      <svg aria-hidden="true" class="i-play" width="18" height="18" viewBox="0 0 18 18"><path d="M5 2 L16 9 L5 16 Z" /></svg>
      <svg aria-hidden="true" class="i-pause" width="18" height="18" viewBox="0 0 18 18"><path d="M5 3 V15 M13 3 V15" /></svg>
    </button>
    <button type="button" class="ctl" aria-label="Next track" data-next>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M4 3 L11 8 L4 13 Z M12 3 V13" /></svg>
    </button>
    <div class="now-text" aria-live="polite">
      <span class="status" data-status>Paused · {title}</span>
      <span class="now-song"><b data-song>{tracks[0].song}</b> · <span data-artist>{tracks[0].artist}</span></span>
    </div>
  </div>

  <ol class="tracks">
    {tracks.map((t, i) => (
      <li>
        <button type="button" class="track" data-track={i} data-n={pad(i + 1)} data-song={t.song} data-artist={t.artist} data-url={t.url} aria-current={i === 0 ? 'true' : 'false'}>
          <span class="mark">{pad(i + 1)}</span>
          <span><b>{t.song}</b> · {t.artist}</span>
        </button>
      </li>
    ))}
  </ol>
  <span class="byline">{curator}</span>
</div>

<style>
  .player {
    background: var(--violet); color: var(--on-violet);
    padding: var(--space-7); display: flex; flex-direction: column; gap: 28px;
  }
  .player-head { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4); }
  .player-title { color: var(--white); font-size: 72px; line-height: 0.9; }
  .note path { fill: none; stroke: var(--on-violet); stroke-width: 3; stroke-linejoin: round; }
  .note circle { fill: var(--yellow); stroke: var(--on-violet); stroke-width: 3; }
  .now {
    background: var(--night); color: var(--on-night);
    padding: var(--space-4); display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap;
  }
  .ctl {
    width: var(--touch-min); height: var(--touch-min); border-radius: var(--radius-pill);
    border: var(--border-bold) solid var(--on-night); background: transparent; color: var(--on-night);
    cursor: pointer; display: flex; align-items: center; justify-content: center;
  }
  .ctl path { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
  .play {
    width: 56px; height: 56px; border-radius: var(--radius-pill);
    border: var(--border-bold) solid var(--on-yellow); background: var(--yellow); color: var(--on-yellow);
    cursor: pointer; display: flex; align-items: center; justify-content: center;
  }
  .i-play path { fill: currentColor; }
  .i-pause path { stroke: currentColor; stroke-width: 3; stroke-linecap: round; }
  .i-pause { display: none; }
  .player[data-playing] .i-pause { display: block; }
  .player[data-playing] .i-play { display: none; }
  .now-text { flex: 1 1 200px; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .status { font: 600 11px/1.4 var(--font-sans); letter-spacing: 2px; text-transform: uppercase; color: var(--yellow); }
  .now-song { font: 400 17px/1.4 var(--font-slab); }
  .tracks { margin: 0; padding: 0; list-style: none; font: 400 18px/1.5 var(--font-slab); }
  .tracks li { border-bottom: var(--border-hairline) solid var(--on-violet); }
  .track {
    width: 100%; display: flex; gap: var(--space-4); padding: 10px var(--space-2); min-height: var(--touch-min);
    border: 0; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer;
  }
  .track:hover { background: var(--paper-deep); color: var(--ink); }
  .track[aria-current='true'] { background: var(--yellow); color: var(--on-yellow); }
  .mark { width: 28px; flex: none; font: 600 13px/1 var(--font-sans); padding-top: 6px; }
  @media (max-width: 599px) {
    .player { padding: var(--space-5); }
    .player-title { font-size: 56px; }
    .tracks { font-size: 16px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
    const rows = [...player.querySelectorAll<HTMLButtonElement>('[data-track]')];
    const toggle = player.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const status = player.querySelector<HTMLElement>('[data-status]')!;
    const song = player.querySelector<HTMLElement>('[data-song]')!;
    const artist = player.querySelector<HTMLElement>('[data-artist]')!;
    const total = player.dataset.total;
    const title = player.querySelector('.player-title')?.textContent ?? '';
    let i = 0;
    let playing = false;

    const render = () => {
      rows.forEach((row, k) => {
        row.setAttribute('aria-current', k === i ? 'true' : 'false');
        row.querySelector('.mark')!.textContent = k === i && playing ? '♪' : row.dataset.n!;
      });
      song.textContent = rows[i].dataset.song!;
      artist.textContent = rows[i].dataset.artist!;
      status.textContent = playing ? `Now playing · ${rows[i].dataset.n} / ${total}` : `Paused · ${title}`;
      toggle.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      player.toggleAttribute('data-playing', playing);
    };

    const go = (k: number) => {
      i = (k + rows.length) % rows.length;
      playing = true;
      render();
      const url = rows[i].dataset.url;
      if (url) window.open(url, '_blank', 'noopener');
    };

    rows.forEach((row, k) => row.addEventListener('click', () => go(k)));
    player.querySelector('[data-prev]')!.addEventListener('click', () => go(i - 1));
    player.querySelector('[data-next]')!.addEventListener('click', () => go(i + 1));
    toggle.addEventListener('click', () => { playing = !playing; render(); });
  });
</script>
