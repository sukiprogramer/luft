---
// A project card styled like a newspaper column. The whole card is one link.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { link } from '../data/link';

interface Props {
  href: string;
  kicker: string;
  title: string;
  blurb: string;
  image?: ImageMetadata;
  imageAlt?: string;
  headingLevel?: 'h2' | 'h3';
}
const { href, kicker, title, blurb, image, imageAlt = '', headingLevel: H = 'h3' } = Astro.props;
---
<a class="np-card" href={link(href)}>
  <span class="np-kicker">{kicker}</span>
  {image
    ? <Image src={image} alt={imageAlt} class="np-img" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 600px" />
    : <div class="np-img ph-photo" role="img" aria-label="Project image placeholder">[ Project image ]</div>}
  <H class="title">{title}</H>
  <p class="np-blurb">{blurb}</p>
</a>

<style>
  .np-card {
    display: flex; flex-direction: column; gap: var(--space-4);
    background: var(--paper-deep); color: var(--ink);
    padding: var(--space-5); text-decoration: none;
    border-radius: var(--radius-0);
  }
  .np-card:hover { color: var(--ink); }
  .np-card:hover .title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .np-kicker {
    border-top: var(--border-hairline) solid var(--line);
    border-bottom: var(--border-hairline) solid var(--line);
    padding: var(--space-2) 0; text-align: center;
    font: 600 12px/1.4 var(--font-sans); letter-spacing: 2px; text-transform: uppercase;
  }
  .np-img { aspect-ratio: 4 / 3; width: 100%; object-fit: cover; }
  .np-blurb { font-size: 14px; line-height: 1.6; color: var(--ink-soft); }
</style>
