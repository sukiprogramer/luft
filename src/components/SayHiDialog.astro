---
// The contact dialog opened by every [data-say-hi] button. A centred dialog on desktop, a bottom sheet on phones.
import Sticker from './Sticker.astro';
import { site } from '../data/site';
---
<dialog id="say-hi" class="say-hi" aria-labelledby="say-hi-title" aria-modal="true">
  <button type="button" class="close" aria-label="Close" data-say-hi-close autofocus>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 3 L13 13 M13 3 L3 13" /></svg>
  </button>

  <div class="portrait">
    <Sticker size={152} class="portrait-star" />
    <div class="photo" role="img" aria-label="Photo of Suki (placeholder)">[ Your<br />photo ]</div>
  </div>

  <h2 id="say-hi-title" class="disp title-hi">Say <span>hi.</span></h2>
  <p class="line">{site.sayHiLine}</p>

  <div class="rows">
    <a class="row row-paper" href={site.linkedin.href}>
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><rect x="2.5" y="2.5" width="19" height="19" rx="4" /><path d="M7.5 10.5 V17 M7.5 7.3 V7.4 M11.5 17 V10.5 M11.5 13.5 C11.5 11.5 16.5 10.5 16.5 13.5 V17" /></svg>
      <span class="row-text"><span class="row-label">LinkedIn</span><span class="row-handle">{site.linkedin.label}</span></span>
      <span aria-hidden="true">→</span>
    </a>
    <a class="row row-violet" href={site.instagram.href}>
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" /><circle cx="12" cy="12" r="4.2" /><circle class="dot" cx="17.3" cy="6.7" r="1.2" /></svg>
      <span class="row-text"><span class="row-label">Instagram</span><span class="row-handle">{site.instagram.label}</span></span>
      <span aria-hidden="true">→</span>
    </a>
    <a class="row row-yellow" href={site.emailHref}>
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2" /><path d="M3.5 6.5 L12 13 L20.5 6.5" /></svg>
      <span class="row-text"><span class="row-label">Email</span><span class="row-handle">{site.email}</span></span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
  <span class="sign" aria-hidden="true">LUFT</span>
</dialog>

<style>
  .say-hi {
    width: calc(100% - 2 * var(--space-4)); max-width: 520px;
    max-height: calc(100dvh - 2 * var(--space-4));
    background: var(--paper); color: var(--ink);
    border: var(--border-bold) solid var(--line);
    box-shadow: var(--shadow-offset);
    padding: 40px var(--space-6) var(--space-6);
    flex-direction: column; align-items: center; gap: var(--space-5); text-align: center;
    overflow-y: auto;
  }
  .say-hi[open] { display: flex; animation: hi-fade 160ms ease-out; }
  .close {
    position: absolute; top: var(--space-3); right: var(--space-3);
    width: var(--touch-min); height: var(--touch-min);
    border-radius: var(--radius-pill); border: var(--border-bold) solid var(--line);
    background: var(--paper); color: var(--ink); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .close path { stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; }
  .portrait { position: relative; width: 152px; height: 152px; display: flex; align-items: center; justify-content: center; flex: none; }
  .portrait :global(.portrait-star) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .photo {
    position: relative; width: 112px; height: 112px; border-radius: var(--radius-pill);
    background: var(--photo); color: var(--on-photo); border: var(--border-bold) solid var(--line);
    font: 500 11px/1.3 var(--font-sans); text-transform: uppercase;
    display: flex; align-items: center; justify-content: center; text-align: center;
  }
  .title-hi { font-size: 56px; line-height: 0.95; }
  .title-hi span { color: var(--violet); }
  .line { font-size: 16px; line-height: 1.6; color: var(--ink-soft); max-width: 360px; }
  .rows { width: 100%; display: flex; flex-direction: column; gap: 10px; margin-top: var(--space-1); }
  .row {
    display: flex; align-items: center; gap: 14px; padding: 14px 18px;
    border: var(--border-bold) solid var(--line); border-radius: var(--radius-md);
    text-decoration: none; text-align: left; min-height: var(--touch-min);
  }
  .row svg { flex: none; }
  .row svg rect, .row svg path, .row svg circle { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .row svg .dot { fill: currentColor; stroke: none; }
  .row-paper { background: var(--paper); color: var(--ink); }
  .row-violet { background: var(--violet); color: var(--on-violet); border-color: var(--on-violet); }
  .row-yellow { background: var(--yellow); color: var(--on-yellow); border-color: var(--on-yellow); }
  .row:hover { color: inherit; transform: translate(-2px, -2px); }
  .row-text { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .row-label { font: 600 11px/1.4 var(--font-sans); letter-spacing: 2px; text-transform: uppercase; }
  .row-handle { font-size: 16px; font-weight: 500; overflow-wrap: anywhere; }
  .sign { font-family: var(--font-hand); font-size: 26px; letter-spacing: 2px; }

  @media (max-width: 599px) {
    .say-hi {
      width: 100%; max-width: none; margin: auto 0 0;
      border: 0; border-top: var(--border-bold) solid var(--line);
      border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
      box-shadow: none; padding: var(--space-7) var(--gutter-mobile) var(--space-6);
    }
    .say-hi[open] { animation-name: sheet-up; }
    .portrait { width: 120px; height: 120px; }
    .photo { width: 88px; height: 88px; }
    .title-hi { font-size: 46px; }
  }
  @keyframes hi-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes sheet-up { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
</style>
