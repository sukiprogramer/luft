---
// Hand-drawn doodles. Decorative, so hidden from assistive tech.
interface Props { variant?: 'wave' | 'poster' | 'ticks'; class?: string }
const { variant = 'wave', class: className } = Astro.props;
---
{variant === 'wave' && (
  <svg class:list={['doodle', className]} aria-hidden="true" width="90" height="40" viewBox="0 0 90 40"><path d="M4 30 C14 6, 22 34, 32 14 S50 30, 58 10 S76 28, 86 8" /></svg>
)}
{variant === 'poster' && (
  <svg class:list={['doodle', className]} aria-hidden="true" width="120" height="60" viewBox="0 0 120 60"><path d="M6 40 Q20 6 36 34 T66 30 T96 22 T116 30" /><circle cx="20" cy="52" r="3" /><circle cx="104" cy="50" r="4" /></svg>
)}
{variant === 'ticks' && (
  <svg class:list={['doodle', className]} aria-hidden="true" width="180" height="90" viewBox="0 0 180 90"><path d="M8 60 C30 10, 50 80, 72 40 S110 10, 130 50 S160 70, 172 30" /><path d="M150 14 l8 -8 M160 20 l10 -4 M146 8 l2 -6" /></svg>
)}

<style>
  .doodle { color: inherit; flex: none; }
  path { fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; }
  circle { fill: currentColor; }
</style>
